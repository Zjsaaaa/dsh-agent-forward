{
  "name": "dsh-agent-forward",
  "version": "0.4.1",
  "description": "Agent-to-agent messaging across DSH sessions: live or resume-on-demand, workspace-scoped, with reply tokens.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "closed.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/core.test.js && node test/closed.test.js && node test/smoke.mjs",
    "test:unit": "node test/core.test.js && node test/closed.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "session",
    "relay",
    "multi-agent",
    "reply-token"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zjsaaaa/dsh-agent-forward.git"
  },
  "bugs": {
    "url": "https://github.com/Zjsaaaa/dsh-agent-forward/issues"
  },
  "homepage": "https://github.com/Zjsaaaa/dsh-agent-forward#readme"
}
